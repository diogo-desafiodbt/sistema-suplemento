# =============================================================================
# Desafio Diabetes — variáveis de ambiente
# =============================================================================
# 1. Copie este arquivo:  cp .env.example .env.local
# 2. Preencha os valores abaixo
# 3. Reinicie o servidor: npm run dev
#
# Nunca commite .env.local (já está no .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (obrigatório para rodar o app)
# Dashboard: https://supabase.com/dashboard/project/_/settings/api
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui

# Chave service_role — só no servidor (APIs admin, webhooks, checkout).
# Nunca exponha no frontend nem em variáveis NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# -----------------------------------------------------------------------------
# Pagamentos — Pagar.me (obrigatório para checkout)
# Dashboard: https://dashboard.pagar.me/
# Use a secret key da API (autenticação Basic).
# -----------------------------------------------------------------------------
PAGARME_API_KEY=sua_pagarme_api_key_aqui

# Chave PÚBLICA do Pagar.me — usada no navegador pra tokenizar o cartão.
# É pública por natureza (NEXT_PUBLIC_). Nunca colocar a secret key aqui.
NEXT_PUBLIC_PAGARME_PUBLIC_KEY=

# Token do webhook Pagar.me (Authorization: Bearer … ou ?token=)
PAGARME_WEBHOOK_TOKEN=

# -----------------------------------------------------------------------------
# Farmácia — pull API + webhook de despacho
# -----------------------------------------------------------------------------
# Token que NÓS enviamos à Miligrama nas nossas chamadas.
FARMACIA_API_TOKEN=
# Token que a Miligrama envia a NÓS no webhook de despacho. Precisa ser
# diferente do de cima: são sentidos opostos, e um segredo servindo aos dois
# não pode ser girado sem quebrar o outro lado.
FARMACIA_WEBHOOK_TOKEN=

# Token dos webhooks Envie Agora (etiqueta + rastreamento)
SHIPPING_WEBHOOK_TOKEN=

# -----------------------------------------------------------------------------
# Janela de transição de credencial (temporária)
# -----------------------------------------------------------------------------
# Enquanto preenchidas, a credencial ANTERIOR do parceiro continua sendo
# aceita junto com a nova — assim a troca não depende de sincronizar o minuto
# com ele. APAGAR assim que o parceiro confirmar que atualizou o painel:
# deixar para sempre anula a rotação. Remover a variável basta, sem deploy.
# FARMACIA_WEBHOOK_TOKEN_ANTERIOR=
# SHIPPING_WEBHOOK_TOKEN_ANTERIOR=

# -----------------------------------------------------------------------------
# Inngest — jobs em background (opcional em dev local)
# Docs: https://www.inngest.com/docs/sdk/environment-variables
# Com `npx inngest-cli@latest dev`, muitas vezes não precisa preencher aqui.
# -----------------------------------------------------------------------------
# INNGEST_EVENT_KEY=sua_inngest_event_key_aqui
# INNGEST_SIGNING_KEY=sua_inngest_signing_key_aqui

# -----------------------------------------------------------------------------
# E-mail — Resend (opcional; pacote instalado, ainda não usado no código)
# -----------------------------------------------------------------------------
# RESEND_API_KEY=sua_resend_api_key_aqui

# -----------------------------------------------------------------------------
# Frete — Envie Agora (cotação + etiqueta)
# Docs: https://envieagora.com.br/api/v1
# Auth: header apitoken (não Bearer)
# -----------------------------------------------------------------------------
ENVIE_AGORA_API_TOKEN=
ENVIE_AGORA_BASE_URL=https://envieagora.com.br/api/v1

# -----------------------------------------------------------------------------
# Vercel CLI (opcional; gerado automaticamente por `vercel env pull` / link)
# Não é necessário para `npm run dev` local.
# -----------------------------------------------------------------------------
# VERCEL_OIDC_TOKEN=

# -----------------------------------------------------------------------------
# Supabase local (opcional — só se usar `supabase start` na máquina)
# -----------------------------------------------------------------------------
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Suporte por e-mail — Superdomínios (IMAP leitura / SMTP envio)
# Mesma caixa: suporte@desafiodiabetes.com
# -----------------------------------------------------------------------------
# SUPPORT_IMAP_HOST=
# SUPPORT_IMAP_PORT=993
# SUPPORT_IMAP_USER=suporte@desafiodiabetes.com
# SUPPORT_IMAP_PASSWORD=
# SUPPORT_SMTP_HOST=
# SUPPORT_SMTP_PORT=465
# SUPPORT_SMTP_USER=suporte@desafiodiabetes.com
# SUPPORT_SMTP_PASSWORD=
# SUPPORT_NOTIFY_EMAIL=  # quem recebe o lembrete de pendências a cada 12h

# -----------------------------------------------------------------------------
# Anthropic — classificação e redação de sugestão de resposta de suporte
# -----------------------------------------------------------------------------
# ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Hotmart — sync diário de vendas (Guia Primeiro Passo)
# Manager: Ferramentas > Manager de Aplicações > Credenciais
# -----------------------------------------------------------------------------
HOTMART_CLIENT_ID=
HOTMART_CLIENT_SECRET=
HOTMART_BASIC_TOKEN=
HOTMART_PRODUCT_ID=

# -----------------------------------------------------------------------------
# Omie — sync de financeiro (contas pagas/recebidas → fluxo de caixa/DRE)
# Ferramentas > API > Aplicativos
# -----------------------------------------------------------------------------
OMIE_APP_KEY=
OMIE_APP_SECRET=

# -----------------------------------------------------------------------------
# YouTube Analytics — dashboard de performance do canal
# Autorização: node scripts/youtube-auth.mjs (rodar 1x, gera o refresh token)
# -----------------------------------------------------------------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=
