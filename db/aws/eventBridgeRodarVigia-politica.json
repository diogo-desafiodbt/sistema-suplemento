{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RodarTarefaDoVigia",
      "Effect": "Allow",
      "Action": "ecs:RunTask",
      "Resource": "arn:aws:ecs:us-east-1:768102455037:task-definition/vigia:*",
      "Condition": {
        "ArnLike": {
          "ecs:cluster": "arn:aws:ecs:us-east-1:768102455037:cluster/desafiodiabetes"
        }
      }
    },
    {
      "Sid": "EntregarPapeisDaTarefa",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "*",
      "Condition": {
        "StringLike": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    }
  ]
}